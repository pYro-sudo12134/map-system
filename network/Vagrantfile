      /opt/vyatta/sbin/my_set service dhcp-server shared-network-name VLAN30 subnet 2001:db8:30::/64 default-router 2001:db8:30::1
      /opt/vyatta/sbin/my_set service dhcp-server shared-network-name VLAN30 subnet 2001:db8:30::/64 dns-server 2001:db8:5::10
      /opt/vyatta/sbin/my_set service dhcp-server shared-network-name VLAN30 subnet 2001:db8:30::/64 dns-server 2001:db8:6::10
      /opt/vyatta/sbin/my_set service dhcp-server shared-network-name VLAN30 subnet 2001:db8:30::/64 domain-name local.lan
      /opt/vyatta/sbin/my_set service dhcp-server shared-network-name VLAN30 subnet 2001:db8:30::/64 lease 86400
      /opt/vyatta/sbin/my_set service dhcp-server shared-network-name VLAN30 subnet 2001:db8:30::/64 range 0 start 2001:db8:30::100
      /opt/vyatta/sbin/my_set service dhcp-server shared-network-name VLAN30 subnet 2001:db8:30::/64 range 0 stop 2001:db8:30::200

      /opt/vyatta/sbin/my_set service dhcp-server shared-network-name VLAN10 subnet 2001:db8:10::/64 prefix-delegation pool PD-VLAN10

      /opt/vyatta/sbin/my_set service router-advertisements interface bond0
      /opt/vyatta/sbin/my_set service router-advertisements interface bond0 prefix 2001:db8:5::/64
      /opt/vyatta/sbin/my_set service router-advertisements interface bond0 prefix 2001:db8:6::/64

