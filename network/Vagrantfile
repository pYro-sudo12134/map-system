	  /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 5 protocol udp
	  /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 5 destination port 67
	  /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 5 source port 68

	  /opt/vyatta/sbin/my_set interfaces vrrp vrrp10 vrid 10 bfd
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp20 vrid 20 bfd
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp30 vrid 30 bfd

      mkdir -p /config/wireguard
      chmod 700 /config/wireguard

      /opt/vyatta/sbin/my_set interfaces wireguard wg0 address '10.200.201.1/24'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 address '2001:db8:201::1/64'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 description 'RoadWarrior-VPN-Backup'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 port '51820'

      run generate pki wireguard key-pair install interface wg0

      PUBLIC_KEY=$(show interfaces wireguard wg0 public-key)

      echo "$PUBLIC_KEY" > /config/wireguard/R2-public.key

      /opt/vyatta/sbin/my_set interfaces wireguard wg0 peer 'CHANGE_ME_CLIENT_PUBKEY' allowed-ips '10.200.200.2/32'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 peer 'CHANGE_ME_CLIENT_PUBKEY' allowed-ips '2001:db8:200::2/128'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 peer 'CHANGE_ME_CLIENT_PUBKEY' persistent-keepalive '15'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 peer 'CHANGE_ME_CLIENT_PUBKEY' description 'Admin-Laptop-Backup'

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 49 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 49 protocol udp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 49 destination port 51820
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 49 description 'WireGuard-Backup'

      /opt/vyatta/sbin/my_set nat source rule 300 source address '10.200.200.0/24'
      /opt/vyatta/sbin/my_set nat source rule 300 translation address 'masquerade'
      /opt/vyatta/sbin/my_set nat source rule 300 outbound-interface 'bond0'

      /opt/vyatta/sbin/my_set nat source rule 301 source address '2001:db8:200::/64'
      /opt/vyatta/sbin/my_set nat source rule 301 translation address 'masquerade'
      /opt/vyatta/sbin/my_set nat source rule 301 outbound-interface 'bond0'

      echo ""
      echo "========================================="
      echo "R2 WIREGUARD BACKUP SERVER"
      echo "========================================="
      echo "Public Key: $PUBLIC_KEY"
      echo "Interface: wg0"
      echo "Listen Port: 51820"
      echo "Network: 10.200.200.0/24"
      echo ""
      echo "[Peer]  # R2-Backup"
      echo "PublicKey = $PUBLIC_KEY"
      echo "AllowedIPs = 10.0.0.0/8, 192.168.0.0/16, 2001:db8::/32"
      echo "Endpoint = <host_ip>:51820"
      echo "PersistentKeepalive = 15"
      echo "========================================="

      /opt/vyatta/sbin/my_commit
      /bin/cli-shell-api teardownSession
    SHELL
  end

  config.vm.define "DNS1" do |dns|
    dns.vm.network "private_network", ip: "10.0.5.2/30", virtualbox__intnet: "R1_DNS", auto_config: false
    dns.vm.network "private_network", ip: "10.0.6.2/30", virtualbox__intnet: "R2_DNS", auto_config: false

    dns.vm.provision "shell", inline: base_config("DNS1") + <<-SHELL
      TSIG_KEY=$(openssl rand -base64 32 | tr -d '\n')

      /opt/vyatta/sbin/my_set interfaces bonding bond0 mode active-backup
      /opt/vyatta/sbin/my_set interfaces bonding bond0 primary eth0
      /opt/vyatta/sbin/my_set interfaces bonding bond0 member eth0
      /opt/vyatta/sbin/my_set interfaces bonding bond0 member eth1
      /opt/vyatta/sbin/my_set interfaces bonding bond0 description 'DNS-Bond'
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 10.0.5.2/30
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 10.0.6.2/30
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 2001:db8:5::2/64
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 2001:db8:6::2/64

      /opt/vyatta/sbin/my_set service dns forwarding listen-address 10.0.5.2
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 10.0.6.2
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 127.0.0.1
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 10.0.5.10
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 10.0.6.10
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 192.168.10.1
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 192.168.20.1
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 192.168.30.1
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 2001:db8:5::10
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 2001:db8:6::10
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 2001:db8:10::1
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 2001:db8:20::1
      /opt/vyatta/sbin/my_set service dns forwarding listen-address 2001:db8:30::1

      /opt/vyatta/sbin/my_set service dns forwarding allow-from 10.0.0.0/8
      /opt/vyatta/sbin/my_set service dns forwarding allow-from 192.168.0.0/16
      /opt/vyatta/sbin/my_set service dns forwarding allow-from 127.0.0.0/8
      /opt/vyatta/sbin/my_set service dns forwarding allow-from 2001:db8::/32

      /opt/vyatta/sbin/my_set service dns forwarding cache-size 2000000
      /opt/vyatta/sbin/my_set service dns forwarding negative-ttl 3600
      /opt/vyatta/sbin/my_set service dns forwarding timeout 2000
      /opt/vyatta/sbin/my_set service dns forwarding no-serve-rfc1918

      /opt/vyatta/sbin/my_set service dns forwarding dnssec validate
      /opt/vyatta/sbin/my_set service dns forwarding dnssec trust-anchor 'dlv.isc.org'
      /opt/vyatta/sbin/my_set service dns forwarding dnssec trust-anchor 'isc.org'

      /opt/vyatta/sbin/my_set service dns forwarding domain local addnta
      /opt/vyatta/sbin/my_set service dns forwarding domain 10.in-addr.arpa addnta
      /opt/vyatta/sbin/my_set service dns forwarding domain 168.192.in-addr.arpa addnta
      /opt/vyatta/sbin/my_set service dns forwarding domain example.com addnta

      /opt/vyatta/sbin/my_set service dns forwarding name-server 1.1.1.1
      /opt/vyatta/sbin/my_set service dns forwarding name-server 8.8.8.8
      /opt/vyatta/sbin/my_set service dns forwarding name-server 9.9.9.9
      /opt/vyatta/sbin/my_set service dns forwarding name-server 8.8.4.4
      /opt/vyatta/sbin/my_set service dns forwarding name-server 1.0.0.1
      /opt/vyatta/sbin/my_set service dns forwarding name-server 2606:4700:4700::1111
      /opt/vyatta/sbin/my_set service dns forwarding name-server 2001:4860:4860::8888
      /opt/vyatta/sbin/my_set service dns forwarding name-server 2620:fe::fe

      /opt/vyatta/sbin/my_set service dns forwarding authoritative-domain local.lan
      /opt/vyatta/sbin/my_set service dns forwarding authoritative-domain local.lan records a dns1 address 10.0.5.2
      /opt/vyatta/sbin/my_set service dns forwarding authoritative-domain local.lan records a dns1 address 10.0.6.2
      /opt/vyatta/sbin/my_set service dns forwarding authoritative-domain local.lan records a dns-vip address 10.0.5.10
      /opt/vyatta/sbin/my_set service dns forwarding authoritative-domain local.lan records a dns-vip address 10.0.6.10
