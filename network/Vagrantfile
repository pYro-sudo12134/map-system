      /opt/vyatta/sbin/my_set interfaces ethernet eth3 address 2001:db8:10::3/64
      /opt/vyatta/sbin/my_set interfaces ethernet eth3 description 'Access-VLAN10'
      /opt/vyatta/sbin/my_set interfaces ethernet eth3 firewall in name VLAN10-IN

      /opt/vyatta/sbin/my_set interfaces ethernet eth4 address 192.168.20.3/24
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 address 2001:db8:20::3/64
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 description 'Access-VLAN20'
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 firewall in name VLAN20-IN

      /opt/vyatta/sbin/my_set interfaces ethernet eth5 address 192.168.30.3/24
      /opt/vyatta/sbin/my_set interfaces ethernet eth5 address 2001:db8:30::3/64
      /opt/vyatta/sbin/my_set interfaces ethernet eth5 description 'Access-VLAN30'
      /opt/vyatta/sbin/my_set interfaces ethernet eth5 firewall in name VLAN30-IN

      /opt/vyatta/sbin/my_set firewall name VLAN10-IN default-action drop
      /opt/vyatta/sbin/my_set firewall name VLAN10-IN rule 10 action accept
      /opt/vyatta/sbin/my_set firewall name VLAN10-IN rule 10 state established enable
      /opt/vyatta/sbin/my_set firewall name VLAN10-IN rule 10 state related enable
      /opt/vyatta/sbin/my_set firewall name VLAN10-IN rule 20 action accept
      /opt/vyatta/sbin/my_set firewall name VLAN10-IN rule 20 source address 192.168.10.0/24

      /opt/vyatta/sbin/my_set firewall name VLAN20-IN default-action drop
      /opt/vyatta/sbin/my_set firewall name VLAN20-IN rule 10 action accept
      /opt/vyatta/sbin/my_set firewall name VLAN20-IN rule 10 state established enable
      /opt/vyatta/sbin/my_set firewall name VLAN20-IN rule 10 state related enable
      /opt/vyatta/sbin/my_set firewall name VLAN20-IN rule 20 action accept
      /opt/vyatta/sbin/my_set firewall name VLAN20-IN rule 20 source address 192.168.20.0/24

      /opt/vyatta/sbin/my_set firewall name VLAN30-IN default-action drop
      /opt/vyatta/sbin/my_set firewall name VLAN30-IN rule 10 action accept
      /opt/vyatta/sbin/my_set firewall name VLAN30-IN rule 10 state established enable
      /opt/vyatta/sbin/my_set firewall name VLAN30-IN rule 10 state related enable
      /opt/vyatta/sbin/my_set firewall name VLAN30-IN rule 20 action accept
      /opt/vyatta/sbin/my_set firewall name VLAN30-IN rule 20 source address 192.168.30.0/24

      /opt/vyatta/sbin/my_set protocols ospf area 0 network 10.0.1.0/30
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 10.0.4.0/30
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 192.168.10.0/24
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 192.168.20.0/24
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 192.168.30.0/24

      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:2::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:4::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:10::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:20::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:30::/64

      /opt/vyatta/sbin/my_set protocols ospf area 0 authentication md5
      /opt/vyatta/sbin/my_set protocols ospf area 0 authentication md5 key-id 1
      /opt/vyatta/sbin/my_set protocols ospf area 0 authentication md5 key-id 1 md5-key 'VyOS_OSPF_Key_2026!'

      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec spi 256
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec esp encryption 'aes256'
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec esp hash 'sha256'
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec esp key 'VyOS_OSPFv3_Key_2026!'

      /opt/vyatta/sbin/my_set protocols ospf bfd
      /opt/vyatta/sbin/my_set protocols ospfv3 bfd

      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.1.1 interval rx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.1.1 interval tx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.1.1 multiplier 3

      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:2::1 interval rx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:2::1 interval tx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:2::1 multiplier 3

