unless Vagrant.has_plugin?("vagrant-vyos")
  system("vagrant plugin install vagrant-vyos")
end

Vagrant.configure("2") do |config|
  config.vm.box = "vyos/current"
  config.vm.guest = :debian
  
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 512
    vb.cpus = 1
    vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
    vb.customize ["modifyvm", :id, "--nicpromisc3", "allow-all"]
    vb.customize ["modifyvm", :id, "--nicpromisc4", "allow-all"]
    vb.customize ["modifyvm", :id, "--nicpromisc5", "allow-all"]
    vb.customize ["modifyvm", :id, "--nicpromisc6", "allow-all"]
    vb.customize ["modifyvm", :id, "--nicpromisc7", "allow-all"]
    vb.customize ["modifyvm", :id, "--nicpromisc8", "allow-all"]
  end

  config.vm.network "public_network",
    bridge: "Hyper-V Virtual Ethernet Adapter",
    auto_config: false

  def base_config(hostname)
    return <<-SHELL
      session_env=$(/bin/cli-shell-api getSessionEnv $$)
      eval $session_env
      /bin/cli-shell-api setupSession

      /opt/vyatta/sbin/my_set system host-name #{hostname}
      /opt/vyatta/sbin/my_set system login user vyos authentication plaintext-password 'VyOS123!'
      /opt/vyatta/sbin/my_set service ssh port 22

      /opt/vyatta/sbin/my_set system ipv6 enable-forwarding

      /opt/vyatta/sbin/my_set firewall state-policy established action accept
      /opt/vyatta/sbin/my_set firewall state-policy related action accept
      /opt/vyatta/sbin/my_set firewall state-policy invalid action drop

      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN default-action drop
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 10 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 10 state established enable
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 10 state related enable

      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 15 action drop
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 15 protocol tcp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 15 tcp flags SYN
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 15 recent count 5
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 15 recent time 10
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 15 log enable

      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 100 action drop
      /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 100 log enable

      /opt/vyatta/sbin/my_set firewall name DEFAULT-OUT default-action accept

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL default-action drop

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 10 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 10 state established enable
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 10 state related enable

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 20 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 20 protocol icmp

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 30 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 30 protocol tcp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 30 destination port 22

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 35 action drop
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 35 protocol tcp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 35 destination port 22
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 35 recent count 3
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 35 recent time 60
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 35 log enable

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 40 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 40 protocol udp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 40 destination port 53

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 41 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 41 protocol tcp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 41 destination port 53

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 42 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 42 protocol ipv6-icmp

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 43 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 43 protocol ipv6-icmp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 43 icmpv6 type router-advertisement

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 44 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 44 protocol ipv6-icmp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 44 icmpv6 type router-solicitation

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 45 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 45 protocol ipv6-icmp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 45 icmpv6 type neighbour-advertisement

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 46 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 46 protocol ipv6-icmp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 46 icmpv6 type neighbour-solicitation

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 47 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 47 protocol udp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 47 destination port 546

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 48 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 48 protocol udp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 48 destination port 547

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 100 action drop
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 100 log enable

      for i in 0 1 2 3 4 5 6 7 8; do
        /opt/vyatta/sbin/my_set interfaces ethernet eth$i firewall in name DEFAULT-IN 2>/dev/null || true
        /opt/vyatta/sbin/my_set interfaces ethernet eth$i firewall out name DEFAULT-OUT 2>/dev/null || true
        /opt/vyatta/sbin/my_set interfaces ethernet eth$i firewall local name DEFAULT-LOCAL 2>/dev/null || true
      done
    SHELL
  end

  config.vm.define "R1" do |r1|
    r1.vm.network "public_network", bridge: "Hyper-V Virtual Ethernet Adapter", auto_config: false
    r1.vm.network "private_network", ip: "10.0.0.1/29", virtualbox__intnet: "R1_R2", auto_config: false
    r1.vm.network "private_network", ip: "10.0.1.1/30", virtualbox__intnet: "R1_S1", auto_config: false
    r1.vm.network "private_network", ip: "10.0.5.1/30", virtualbox__intnet: "R1_DNS", auto_config: false
    r1.vm.network "private_network", virtualbox__intnet: "TRUNK_NET", auto_config: false

    r1.vm.provision "shell", inline: base_config("R1") + <<-SHELL
      /opt/vyatta/sbin/my_set interfaces bonding bond0 mode active-backup
      /opt/vyatta/sbin/my_set interfaces bonding bond0 primary eth0
      /opt/vyatta/sbin/my_set interfaces bonding bond0 member eth0
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address dhcp
      /opt/vyatta/sbin/my_set interfaces bonding bond0 description 'WAN-Bond'

      /opt/vyatta/sbin/my_set interfaces bonding bond1 mode 802.3ad
      /opt/vyatta/sbin/my_set interfaces bonding bond1 member eth1
      /opt/vyatta/sbin/my_set interfaces bonding bond1 member eth2
      /opt/vyatta/sbin/my_set interfaces bonding bond1 member eth3
      /opt/vyatta/sbin/my_set interfaces bonding bond1 description 'Internal-Bond-LACP'
      /opt/vyatta/sbin/my_set interfaces bonding bond1 address 10.0.0.1/29
      /opt/vyatta/sbin/my_set interfaces bonding bond1 address 10.0.1.1/30
      /opt/vyatta/sbin/my_set interfaces bonding bond1 address 10.0.5.1/30
      /opt/vyatta/sbin/my_set interfaces bonding bond1 address 2001:db8:1::1/64
      /opt/vyatta/sbin/my_set interfaces bonding bond1 address 2001:db8:2::1/64
      /opt/vyatta/sbin/my_set interfaces bonding bond1 address 2001:db8:5::1/64

      /opt/vyatta/sbin/my_set interfaces ethernet eth4 description 'TRUNK-PORT'

      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 10
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 10 address 192.168.10.1/24
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 10 address 2001:db8:10::1/64
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 10 description 'VLAN10-Gateway'
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 10 firewall in name DEFAULT-IN
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 10 firewall out name DEFAULT-OUT
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 10 firewall local name DEFAULT-LOCAL

      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 20
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 20 address 192.168.20.1/24
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 20 address 2001:db8:20::1/64
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 20 description 'VLAN20-Gateway'
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 20 firewall in name DEFAULT-IN
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 20 firewall out name DEFAULT-OUT
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 20 firewall local name DEFAULT-LOCAL

      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 30
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 30 address 192.168.30.1/24
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 30 address 2001:db8:30::1/64
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 30 description 'VLAN30-Gateway'
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 30 firewall in name DEFAULT-IN
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 30 firewall out name DEFAULT-OUT
      /opt/vyatta/sbin/my_set interfaces ethernet eth4 vif 30 firewall local name DEFAULT-LOCAL

      /opt/vyatta/sbin/my_set nat source rule 100 source address 10.0.0.0/8
      /opt/vyatta/sbin/my_set nat source rule 100 translation address masquerade
      /opt/vyatta/sbin/my_set nat source rule 100 outbound-interface bond0

      /opt/vyatta/sbin/my_set nat source rule 101 source address 192.168.0.0/16
      /opt/vyatta/sbin/my_set nat source rule 101 translation address masquerade
      /opt/vyatta/sbin/my_set nat source rule 101 outbound-interface bond0

      /opt/vyatta/sbin/my_set nat source rule 200 source address 2001:db8::/32
      /opt/vyatta/sbin/my_set nat source rule 200 translation address masquerade
      /opt/vyatta/sbin/my_set nat source rule 200 outbound-interface bond0

      /opt/vyatta/sbin/my_set protocols ospf area 0 network 10.0.0.0/29
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 10.0.1.0/30
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 10.0.5.0/30
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 192.168.10.0/24
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 192.168.20.0/24
      /opt/vyatta/sbin/my_set protocols ospf area 0 network 192.168.30.0/24

      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:1::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:2::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:5::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:10::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:20::/64
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 network 2001:db8:30::/64

      /opt/vyatta/sbin/my_set protocols ospf area 0 authentication md5
      /opt/vyatta/sbin/my_set protocols ospf area 0 authentication md5 key-id 1
      /opt/vyatta/sbin/my_set protocols ospf area 0 authentication md5 key-id 1 md5-key 'VyOS_OSPF_Key_2026!'

      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec spi 256
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec esp encryption 'aes256'
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec esp hash 'sha256'
      /opt/vyatta/sbin/my_set protocols ospfv3 area 0 authentication ipsec esp key 'VyOS_OSPFv3_Key_2026!'

      /opt/vyatta/sbin/my_set protocols ospf bfd
      /opt/vyatta/sbin/my_set protocols ospfv3 bfd

      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.0.2
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.0.2 interval rx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.0.2 interval tx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.0.2 multiplier 3

      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:1::2
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:1::2 interval rx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:1::2 interval tx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:1::2 multiplier 3

      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.1.2
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.1.2 interval rx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.1.2 interval tx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.1.2 multiplier 3

      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:2::2
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:2::2 interval rx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:2::2 interval tx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:2::2 multiplier 3

      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.5.2
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.5.2 interval rx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.5.2 interval tx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 10.0.5.2 multiplier 3

      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:5::2
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:5::2 interval rx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:5::2 interval tx 300
      /opt/vyatta/sbin/my_set protocols bfd peer 2001:db8:5::2 multiplier 3

      /opt/vyatta/sbin/my_set interfaces vrrp vrrp10 vrid 10 interface eth4.10
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp10 vrid 10 priority 150
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp10 vrid 10 address 192.168.10.1/24
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp10 vrid 10 address 2001:db8:10::1/64
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp10 vrid 10 authentication password 'VRRP_Pass_10!'

      /opt/vyatta/sbin/my_set interfaces vrrp vrrp20 vrid 20 interface eth4.20
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp20 vrid 20 priority 100
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp20 vrid 20 address 192.168.20.1/24
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp20 vrid 20 address 2001:db8:20::1/64
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp20 vrid 20 authentication password 'VRRP_Pass_20!'

      /opt/vyatta/sbin/my_set interfaces vrrp vrrp30 vrid 30 interface eth4.30
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp30 vrid 30 priority 150
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp30 vrid 30 address 192.168.30.1/24
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp30 vrid 30 address 2001:db8:30::1/64
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp30 vrid 30 authentication password 'VRRP_Pass_30!'

      /opt/vyatta/sbin/my_set interfaces vrrp vrrp1 vrid 1 interface bond1
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp1 vrid 1 priority 150
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp1 vrid 1 address 10.0.0.10/29
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp1 vrid 1 authentication password 'VRRP_Pass_1!'

      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.10
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.10 prefix 2001:db8:10::/64
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.10 prefix 2001:db8:10::/64 preferred-lifetime 604800
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.10 prefix 2001:db8:10::/64 valid-lifetime 2592000

      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.20
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.20 prefix 2001:db8:20::/64
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.20 prefix 2001:db8:20::/64 preferred-lifetime 604800
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.20 prefix 2001:db8:20::/64 valid-lifetime 2592000

      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.30
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.30 prefix 2001:db8:30::/64
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.30 prefix 2001:db8:30::/64 preferred-lifetime 604800
      /opt/vyatta/sbin/my_set service router-advertisements interface eth4.30 prefix 2001:db8:30::/64 valid-lifetime 2592000

	  /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 5 action accept
	  /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 5 protocol udp
	  /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 5 destination port 67
	  /opt/vyatta/sbin/my_set firewall name DEFAULT-IN rule 5 source port 68

	  /opt/vyatta/sbin/my_set interfaces vrrp vrrp10 vrid 10 bfd
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp20 vrid 20 bfd
      /opt/vyatta/sbin/my_set interfaces vrrp vrrp30 vrid 30 bfd

      mkdir -p /config/wireguard
      chmod 700 /config/wireguard

      /opt/vyatta/sbin/my_set interfaces wireguard wg0 address '10.200.200.1/24'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 address '2001:db8:200::1/64'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 description 'RoadWarrior-VPN-Primary'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 port '51820'

      run generate pki wireguard key-pair install interface wg0

      PUBLIC_KEY=$(show interfaces wireguard wg0 public-key)

      echo "$PUBLIC_KEY" > /config/wireguard/R1-public.key

      /opt/vyatta/sbin/my_set interfaces wireguard wg0 peer 'CHANGE_ME_CLIENT_PUBKEY' allowed-ips '10.200.200.2/32'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 peer 'CHANGE_ME_CLIENT_PUBKEY' allowed-ips '2001:db8:200::2/128'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 peer 'CHANGE_ME_CLIENT_PUBKEY' persistent-keepalive '15'
      /opt/vyatta/sbin/my_set interfaces wireguard wg0 peer 'CHANGE_ME_CLIENT_PUBKEY' description 'Admin-Laptop'

      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 49 action accept
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 49 protocol udp
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 49 destination port 51820
      /opt/vyatta/sbin/my_set firewall name DEFAULT-LOCAL rule 49 description 'WireGuard-Primary'

      /opt/vyatta/sbin/my_set nat source rule 300 source address '10.200.200.0/24'
      /opt/vyatta/sbin/my_set nat source rule 300 translation address 'masquerade'
      /opt/vyatta/sbin/my_set nat source rule 300 outbound-interface 'bond0'

      /opt/vyatta/sbin/my_set nat source rule 301 source address '2001:db8:200::/64'
      /opt/vyatta/sbin/my_set nat source rule 301 translation address 'masquerade'
      /opt/vyatta/sbin/my_set nat source rule 301 outbound-interface 'bond0'

	  /opt/vyatta/sbin/my_set service dhcp-relay interface eth3.10
	  /opt/vyatta/sbin/my_set service dhcp-relay interface eth3.20
	  /opt/vyatta/sbin/my_set service dhcp-relay interface eth3.30
	  /opt/vyatta/sbin/my_set service dhcp-relay server 10.0.5.10
	  /opt/vyatta/sbin/my_set service dhcp-relay server 10.0.6.10

      /opt/vyatta/sbin/my_set protocols static route 10.200.200.2/32 next-hop 10.200.200.1

      echo ""
      echo "========================================="
      echo "R1 WIREGUARD PRIMARY SERVER"
      echo "========================================="
      echo "Public Key: $PUBLIC_KEY"
      echo "Interface: wg0"
      echo "Listen Port: 51820"
      echo "Network: 10.200.200.0/24"
      echo ""
      echo "CLIENT CONFIG:"
      echo ""
      echo "[Interface]"
      echo "PrivateKey = <on_client_to_configure>"
      echo "Address = 10.200.200.2/24"
      echo "Address = 2001:db8:200::2/64"
      echo "DNS = 10.0.5.10, 10.0.6.10"
      echo ""
      echo "[Peer]"
      echo "PublicKey = $PUBLIC_KEY"
      echo "AllowedIPs = 10.0.0.0/8, 192.168.0.0/16, 2001:db8::/32"
      echo "Endpoint = <host_ip>:51820"
      echo "PersistentKeepalive = 15"
      echo "========================================="

      /opt/vyatta/sbin/my_commit
      /bin/cli-shell-api teardownSession
    SHELL
  end

  config.vm.define "R2" do |r2|
    r2.vm.network "private_network", ip: "10.0.0.2/29", virtualbox__intnet: "R1_R2", auto_config: false
    r2.vm.network "private_network", ip: "10.0.3.1/30", virtualbox__intnet: "R2_S2", auto_config: false
    r2.vm.network "private_network", ip: "10.0.6.1/30", virtualbox__intnet: "R2_DNS", auto_config: false
    r2.vm.network "private_network", virtualbox__intnet: "TRUNK_NET", auto_config: false

    r2.vm.provision "shell", inline: base_config("R2") + <<-SHELL
      /opt/vyatta/sbin/my_set interfaces bonding bond0 mode 802.3ad
      /opt/vyatta/sbin/my_set interfaces bonding bond0 member eth0
      /opt/vyatta/sbin/my_set interfaces bonding bond0 member eth1
      /opt/vyatta/sbin/my_set interfaces bonding bond0 member eth2
      /opt/vyatta/sbin/my_set interfaces bonding bond0 description 'Internal-Bond-LACP'
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 10.0.0.2/29
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 10.0.3.1/30
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 10.0.6.1/30
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 2001:db8:1::2/64
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 2001:db8:3::1/64
      /opt/vyatta/sbin/my_set interfaces bonding bond0 address 2001:db8:6::1/64

      /opt/vyatta/sbin/my_set interfaces ethernet eth3 description 'TRUNK-PORT'

      /opt/vyatta/sbin/my_set interfaces ethernet eth3 vif 10
      /opt/vyatta/sbin/my_set interfaces ethernet eth3 vif 10 address 192.168.10.2/24
      /opt/vyatta/sbin/my_set interfaces ethernet eth3 vif 10 address 2001:db8:10::2/64
      /opt/vyatta/sbin/my_set interfaces ethernet eth3 vif 10 description 'VLAN10-Backup'
      /opt/vyatta/sbin/my_set interfaces ethernet eth3 vif 10 firewall in name DEFAULT-IN
      /opt/vyatta/sbin/my_set interfaces ethernet eth3 vif 10 firewall out name DEFAULT-OUT
